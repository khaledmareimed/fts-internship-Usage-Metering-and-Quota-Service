# Postgres (used by the postgres container and to build DATABASE_URL)
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering
POSTGRES_DB=metering

# Service
DATABASE_URL=postgres://metering:metering@postgres:5432/metering
# Internal API port; Docker publishes it on host port 50000.
PORT=3000
DB_POOL_MAX=20
# Max wait to open a DB connection or get a free one from the pool under load
DB_CONNECT_TIMEOUT_MS=10000
LOG_LEVEL=info
# Protects POST /v1/accounts. At least 32 chars; change it outside local dev.
ADMIN_KEY=dev-only-admin-key-change-me-0000000000

# Example client (server-side only). Compose sets SERVICE_URL=http://service:3000;
# for `npm run dev` in client/ against the Compose API use its published host port.
SERVICE_URL=http://localhost:50000
